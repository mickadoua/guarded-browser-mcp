# CDP gate in front of Chromium: only the secret path opens browser control, with no access log (the secret is
# in the URL). Chrome only listens on 127.0.0.1; this nginx shares its network namespace.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server {
  listen 9223;
  access_log off;
  location /${CDP_TOKEN}/ {
    proxy_pass http://127.0.0.1:9222/;
    proxy_http_version 1.1;
    proxy_set_header Host localhost;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 1h;
    proxy_set_header Accept-Encoding "";
    sub_filter_types application/json;
    sub_filter_once off;
    sub_filter 'ws://localhost/' 'ws://${CDP_HOST}:9223/${CDP_TOKEN}/';
  }
  location / { return 404; }
}
